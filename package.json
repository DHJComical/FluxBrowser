{
	"devDependencies": {
		"electron": "^41.8.0",
		"electron-builder": "^26.8.1"
	},
	"name": "fluxbrowser",
	"version": "0.0.0-dev",
	"main": "src/main/main.js",
	"dependencies": {
		"boolean": "^3.2.0",
		"buffer-crc32": "^1.0.0",
		"cacheable-lookup": "^7.0.0",
		"cacheable-request": "^13.0.18",
		"clone-response": "^2.0.0",
		"debug": "^4.4.3",
		"decompress-response": "^10.0.0",
		"defer-to-connect": "^2.0.1",
		"define-data-property": "^1.1.4",
		"define-properties": "^1.2.1",
		"detect-node": "^2.1.0",
		"electron-log": "^5.4.3",
		"electron-updater": "^6.8.3",
		"end-of-stream": "^1.4.5",
		"env-paths": "^4.0.0",
		"es-define-property": "^1.0.1",
		"es-errors": "^1.3.0",
		"es6-error": "^4.1.1",
		"escape-string-regexp": "^5.0.0",
		"extract-zip": "^2.0.1",
		"fd-slicer": "^1.1.0",
		"fs-extra": "^11.3.4",
		"get-stream": "^9.0.1",
		"global-agent": "^4.1.3",
		"globalthis": "^1.0.4",
		"gopd": "^1.2.0",
		"got": "^15.0.0",
		"graceful-fs": "^4.2.11",
		"has-property-descriptors": "^1.0.2",
		"http-cache-semantics": "^4.2.0",
		"http2-wrapper": "^2.2.1",
		"json-buffer": "^3.0.1",
		"json-stringify-safe": "^5.0.1",
		"jsonfile": "^6.2.0",
		"keyv": "^5.6.0",
		"lowercase-keys": "^4.0.1",
		"matcher": "^6.0.0",
		"mimic-response": "^4.0.0",
		"ms": "^2.1.3",
		"normalize-url": "^9.0.0",
		"object-keys": "^1.1.1",
		"once": "^1.4.0",
		"p-cancelable": "^4.0.1",
		"pend": "^1.2.0",
		"progress": "^2.0.3",
		"pump": "^3.0.4",
		"quick-lru": "^7.3.0",
		"resolve-alpn": "^1.2.1",
		"responselike": "^4.0.2",
		"roarr": "^7.21.4",
		"semver": "^7.7.4",
		"semver-compare": "^1.0.0",
		"serialize-error": "^13.0.1",
		"sprintf-js": "^1.1.3",
		"sumchecker": "^3.0.1",
		"type-fest": "^5.5.0",
		"undici-types": "^8.0.1",
		"universalify": "^2.0.1",
		"wrappy": "^1.0.2",
		"yauzl": "^3.3.0"
	},
	"scripts": {
		"start": "chcp 65001 && electron .",
		"build": "electron-builder"
	},
	"build": {
		"appId": "com.flux.browser",
		"publish": [
			{
				"provider": "github",
				"owner": "DHJComical",
				"repo": "FluxBrowser",
				"releaseType": "release"
			}
		],
		"productName": "FluxBrowser",
		"directories": {
			"output": "dist"
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "resources/image/FluxBrowser-icon.ico",
			"requestedExecutionLevel": "requireAdministrator"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "FluxBrowser",
			"installerIcon": "resources/image/FluxBrowser-icon.ico",
			"uninstallerIcon": "resources/image/FluxBrowser-icon.ico",
			"uninstallDisplayName": "FluxBrowser",
			"runAfterFinish": true
		},
		"asar": true,
		"files": [
			"src/**/*",
			"package.json"
		]
	},
	"keywords": [],
	"author": "DHJComical",
	"license": "GPL-3.0-or-later",
	"description": "A floating, immersive, framework-based browser.",
	"repository": {
		"type": "git",
		"url": "https://github.com/DHJComical/FluxBrowser.git"
	}
}
